# Required: Google Sheet destination
GOOGLE_SHEET_ID=your_google_sheet_id
SHEET_NAME=Signal Validation Log

# Required: BigQuery source table
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET=agent_outputs
BIGQUERY_TABLE=signals

# Optional: behavior flags
AUTO_CREATE_TABS=true
WRITE_RUN_LOG=true
RUN_LOG_SHEET_NAME=Run Log

# Optional: runtime defaults for Makefile targets
SIGNALS_LIMIT=200
SIGNALS_PRINT_SAMPLE=5
# SIGNALS_EXTRA_ARGS=--input-jsonl scripts/sample_signals.jsonl --source-table agent_outputs.signals
